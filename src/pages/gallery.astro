---
import BaseLayout from '../layouts/BaseLayout.astro';
import { selectedPieces } from '../data/pieces';
---

<BaseLayout title="Gallery — Off-Pat Ceramics" description="Selected bowls, coastal wall pieces and ceramic details by Pat Todd in Felixstowe.">
  <section class="gallery-hero section-sm container">
    <p class="eyebrow" data-edit="gallery.eyebrow" data-edit-label="Work label">Porcelain & stoneware</p>
    <h1 data-edit="gallery.title" data-edit-label="Work heading">Selected work</h1>
    <p class="lead" data-edit="gallery.intro" data-edit-label="Work introduction">Coastal scenes, sculptural bowls and the textures in between.</p>
  </section>
  <section class="container gallery-section" aria-label="Selected ceramics">
    <div class="works-grid">
      {selectedPieces.map(piece => (
        <a href={`/gallery/${piece.slug}`} class="work-card">
          <img data-edit-image={`piece.${piece.slug}.image`} data-edit-label={`${piece.title} — photograph`} src={piece.thumbnail} srcset={`${piece.thumbnail} ${piece.width! / 2}w, ${piece.image} ${piece.width}w`} sizes="(min-width: 1280px) 584px, (min-width: 650px) 46vw, 90vw" alt={piece.alt} width={piece.width} height={piece.height} loading="lazy" decoding="async" />
          <div class="work-info">
            <p class="work-kind" data-edit={`piece.${piece.slug}.kind`} data-edit-label={`${piece.title} — category`}>{piece.kind}</p>
            <h2><span data-edit={`piece.${piece.slug}.title`} data-edit-label={`${piece.title} — name`}>{piece.title}</span> <span aria-hidden="true">↗</span></h2>
          </div>
        </a>
      ))}
    </div>
    <div class="gallery-contact">
      <h2 data-edit="gallery.contact-title" data-edit-label="Enquiry heading">Something caught your eye?</h2>
      <p data-edit="gallery.contact-text" data-edit-label="Enquiry text">Contact me with an enquiry, or find out where you can see my work in person.</p>
      <a href="/contact" class="btn btn-filled">Contact me</a>
      <a href="/events" class="events-link">Upcoming events →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-hero { padding-top: clamp(3rem, 6vw, 5rem); }
  h1 { font-size: clamp(3rem, 7vw, 5.5rem); margin: 0.75rem 0 1.25rem; }
  .lead { max-width: 44ch; }
  .gallery-section { padding-bottom: 2rem; }
  .works-grid { columns: 1; column-gap: 2rem; }
  .work-card { display: inline-block; width: 100%; margin-bottom: 2.5rem; break-inside: avoid; }
  .work-card img { width: 100%; height: auto; background: var(--color-surface); }
  .work-info { margin-top: 1rem; }
  .work-kind { font-size: 0.75rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.1em; }
  .work-info h2 { display: flex; justify-content: space-between; gap: 1rem; font-size: 1.2rem; margin-top: 0.4rem; }
  .work-card:hover h2 { text-decoration: underline; text-underline-offset: 0.2em; }
  .gallery-contact { border-top: 1px solid var(--color-line); padding-top: 3rem; margin-top: 1rem; }
  .gallery-contact h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); }
  .gallery-contact p { margin: 1rem 0 1.5rem; }
  .events-link { display: inline-block; margin: 1rem 1.5rem; text-decoration: underline; text-underline-offset: 0.25em; }
  @media (min-width: 650px) { .works-grid { columns: 2; } }
</style>
