---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';

const formAction = import.meta.env.PUBLIC_CONTACT_FORM_ACTION?.trim();
if (formAction) {
  const endpoint = new URL(formAction);
  if (endpoint.protocol !== 'https:' || endpoint.username || endpoint.password) {
    throw new Error('PUBLIC_CONTACT_FORM_ACTION must be a public HTTPS form endpoint without credentials.');
  }
}
---

<BaseLayout
  title={`Contact — ${site.name}`}
  description="Contact Pat Todd about her ceramics, upcoming events, exhibitions or a studio visit."
>
  <section class="contact section">
    <div class="container">
      <div class="contact-grid">
        <!-- Your real studio image -->
        <div class="contact-image">
          <img 
            src="https://fgxfkyzvkpgrsphgjgxf.supabase.co/storage/v1/object/sign/images/IMG_5175.jpeg?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9hNTI2OGMwYy02NjVlLTQ4YTEtODFlYy0zYTcwY2YwZjdiZDIiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJpbWFnZXMvSU1HXzUxNzUuanBlZyIsImlhdCI6MTc3OTgwMzk4NCwiZXhwIjoyNzI1ODgzOTg0fQ.N4Aga5idbIc94tiRHELEznFCax5yAVJagihHa8SP5B8" 
            alt="Off-Pat Ceramics Studio" 
            loading="lazy"
          />
        </div>

        <div class="contact-content">
          <h1>Contact me</h1>
          <p class="lead">
            For enquiries about my ceramics, where I'll be exhibiting,
            or arranging a studio visit, please get in touch.
          </p>

          {formAction ? <form
            class="contact-form"
            name="contact"
            method="POST"
            action={formAction}
          >
            <label class="field">
              <span class="field-label">Your name</span>
              <input name="name" type="text" required autocomplete="name" />
            </label>

            <label class="field">
              <span class="field-label">Email address</span>
              <input name="email" type="email" required autocomplete="email" />
            </label>

            <label class="field">
              <span class="field-label">Subject</span>
              <select name="subject" required>
                <option value="">Select an option</option>
                <option>Enquiry about my work</option>
                <option>Studio Visit</option>
                <option>Exhibition or event</option>
                <option>Other</option>
              </select>
            </label>

            <label class="field">
              <span class="field-label">Message</span>
              <textarea name="message" rows="6" required></textarea>
            </label>

            <button type="submit" class="btn btn-filled">Send Message</button>
          </form> : (
            <div class="email-contact">
              <p>
                Tell me a little about your enquiry. If it's about a particular
                piece, you can include its name or a link to the photograph.
              </p>
              <a class="btn btn-filled" href={`mailto:${site.email}`}>
                Email Pat
              </a>
            </div>
          )}
          <p class="contact-email">
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          <p class="contact-phone">
            <a href={`tel:${site.phone.replace(/\s/g, '').replace(/^0/, '+44')}`}>{site.phone}</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-image img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 2px;
  }

  .contact-content h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    max-width: 14ch;
  }

  .lead {
    max-width: 44ch;
    font-size: 1.1rem;
    margin-top: 1.5rem;
  }

  .email-contact { margin-top: 2rem; }
  .email-contact .btn { margin-top: 1.5rem; }
  .contact-email { margin-top: 1.25rem; overflow-wrap: anywhere; }
  .contact-phone { margin-top: 0.75rem; }
  .contact-email a, .contact-phone a { text-decoration: underline; text-underline-offset: 0.2em; }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .field input,
  .field select,
  .field textarea {
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-accent);
    background: transparent;
    border-radius: 2px;
  }

  @media (min-width: 800px) {
    .contact-grid {
      grid-template-columns: 1fr 1.15fr;
      gap: 4rem;
    }
  }
</style>
