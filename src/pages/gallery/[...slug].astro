---
import WorkDetail from '../../components/WorkDetail.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allPieces, type Piece } from '../../data/pieces';

export function getStaticPaths() {
  return allPieces.map(piece => ({ params: { slug: piece.slug }, props: { piece } }));
}
interface Props { piece: Piece; }
const { piece } = Astro.props;
---

<BaseLayout title={`${piece.title} — Off-Pat Ceramics`} description={piece.description}>
  <WorkDetail piece={piece} />
</BaseLayout>
